{
    "name": "fcms/fcms",
    "description": "fCMS - Dateibasiertes, DSGVO-konformes Content-Management-System",
    "type": "project",
    "license": "MIT",
    "version": "202511081146-dev",
    "require": {
        "php": ">=8.1",
        "slim/slim": "^4.12",
        "slim/psr7": "^1.6",
        "twig/twig": "^3.7",
        "symfony/yaml": "^6.3",
        "symfony/filesystem": "^6.3",
        "php-di/php-di": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "FCMS\\": "src/",
            "FCMS\\Blocks\\": "blocks/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FCMS\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "build": "php build/build.php",
        "test": "phpunit"
    }
}
